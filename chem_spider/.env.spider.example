# Zyte Spider Configuration
# Copy to .env and fill in your values. Do not commit real secrets.

# Zyte (Scrapy Cloud) - for deployment
ZYTE_API_KEY=your-zyte-api-key-here
ZYTE_PROJECT_ID=your-zyte-project-id-here

# Backend API (your FastAPI on Heroku)
BACKEND_API_URL=your-backend-api-url-here
BACKEND_API_KEY=your-backend-api-key-here

# Output directory for scraped data
SCRAPY_OUTPUT_DIR=./output