# Appwrite Configuration - ChemLeaner Project
# Copy this file to .env and fill in your own values. Do not commit real secrets.
# Get these from your Appwrite console: https://cloud.appwrite.io/
#   Endpoint: Project settings -> API endpoint
#   Project ID: Project settings -> Project ID
#   Database ID: Databases -> your database -> Database ID
#   Collection IDs: Databases -> your database -> Collections -> Collection ID

VITE_APPWRITE_ENDPOINT=
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=
VITE_APPWRITE_LESSONS_COLLECTION_ID=
VITE_APPWRITE_PROFILES_COLLECTION_ID=