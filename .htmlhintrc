{
  "tag-pair": true,
  "tag-self-close": false,
  "doctype-first": true,
  "id-class-value": "dash",
  "style-disabled": true,
  "alt-require": true,
  "href-require": true,
  "src-require": true,
  "title-require": true,
  "doctype-html5": true,
  "id-unique": true,
  "class-id-disallow": true,
  "head-title-disallow-empty": true,
  "img-alt-require": true,
  "aria-require-attr": true,
  "aria-allowed-attr": true,
  "tabindex-require": true,
  "lang-require": true,
  "meta-charset-require": true,
  "meta-viewport-require": true,
  "input-require-label": true,
  "button-type": true,
  "label-for-require": true,
  "form-action-require": true,
  "iframe-title-require": true,
  "frame-title-require": true,
  "no-inline-style": true,
  "no-trailing-whitespace": true,
  "no-duplicate-attributes": true,
  "no-duplicate-id": true,
  "no-empty-element": true,
  "no-space-without-equals-in-attribute": true,
  "no-attribute-first": true,
  "no-attribute-values-without-quotes": true,
  "no-multiple-empty-lines": true,
  "no-undefined-tags": true,
  "no-undefined-attributes": true,
  "no-void-elements-with-children": true,
  "no-void-elements-with-attributes": true,
  "no-void-elements-with-children": true
}
