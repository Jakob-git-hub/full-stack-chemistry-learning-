# Appwrite
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id
APPWRITE_API_KEY=your_api_key
APPWRITE_DATABASE_ID=chemvibe
APPWRITE_COLLECTION_ID=lessons

# Zyte API (web scraping)
ZYTE_API_KEY=your_zyte_api_key
ZYTE_API_URL=https://api.zyte.com/v1/extract

# LLM API (NVIDIA NIM - OpenAI kompatibel)
LLM_API_KEY=your_nvidia_api_key
LLM_API_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3.5-super-49b-v1

# Backend API authentication (protects mutating endpoints)
ADMIN_API_KEY=your_admin_api_key
SPIDER_API_KEY=your_spider_api_key

# Rate limiting
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
