# Zyte Spider Configuration
# Copy to .env and fill in your values

# Zyte (Scrapy Cloud) - for deployment
ZYTE_API_KEY=your-zyte-api-key
ZYTE_PROJECT_ID=chem

# Backend API (your FastAPI on Heroku)
BACKEND_API_URL=https://chemvibe-backend.herokuapp.com
BACKEND_API_KEY=your-backend-api-key

# Output directory for scraped data
SCRAPY_OUTPUT_DIR=./output
